# ==============================================================================
# Student Attendance Tracker - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` or `.env.local` to customize default configuration
# or preconfigure Firebase cloud synchronization without manual paste.

# --- App Defaults ---
VITE_APP_TITLE="Saanvi · Sem 5 Attendance"
VITE_DEFAULT_TARGET_PERCENT=75
VITE_DEFAULT_RESERVE_DAYS=5

# --- Optional Firebase Cloud Sync Configuration ---
# You can leave these blank if syncing manually through the in-app Setup tab.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
